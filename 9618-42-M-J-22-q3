CardArray = []
CardCheck = [False] * 30

class Card:

    def __init__(self, pNumber, PColor):
        self.__number = pNumber
        self.__color = PColor

    def GetNumber(self):
        return self.__number
    
    def GetColor(self):
        return self.__color
    
try:
    CardF = open("CardValues.txt", "r")
    for i in range(30):
        CardArray.append(Card(CardF.readline().strip(), CardF.readline().strip()))
    
    CardF.close
except IOError:
    print("FIle not found")

def ChooseCard():
    global CardCheck
    num = (int(input("Please enter number between 1 and 30"))) - 1
    while num < 0 or num > 29 or CardCheck[num] == True:
         num = (int(input("Please re enter number between 1 and 30"))) - 1
    
    CardCheck[num] = True
    return num

Player1 = []
for i in range(4):
    CardN = ChooseCard()
    Player1.append(CardArray[CardN])

for i in range(4):
    print(Player1[i].GetNumber())
    print(Player1[i].GetColor())


