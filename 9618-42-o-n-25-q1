#i)
class Bird:

    def __init__(self, pSpecies, pDistancePerHour):
        self.__Species = pSpecies
        self.__DistancePerHour = pDistancePerHour
        self.__XPosition = 500.0
        self.__YPosition = 500.0

#ii)

    def GetSpecies(self):
        return self.__Species

#iii)
   
    def GetPosition(self):
        string = f"X = {self.__XPosition} Y = {self.__YPosition}"
        return string
    
#iv)

    def Move(self, DT, Time):
        Distance = (self.__DistancePerHour/60) * Time
        if DT == 'N':
            self.__YPosition += Distance
        elif DT == 'S':
            self.__YPosition -= Distance
        elif DT == 'E':
            self.__XPosition += Distance
        elif DT == 'W':
            self.__XPosition -= Distance

