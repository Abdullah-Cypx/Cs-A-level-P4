#Main Program
FirstBird = Bird("Cockatiel", 71.0)
SecondBird = Bird("Macaw", 56.0)

print(f"The First bird is {FirstBird.GetSpecies()} and the position is {FirstBird.GetPosition()}")
print(f"The First bird is {SecondBird.GetSpecies()} and the position is {SecondBird.GetPosition()}")

Choice = int(input("Please choose bird 1 or bird 2"))
while Choice != 1 and Choice != 2:
    Choice = int(input("Please rechoose bird 1 or bird 2: "))

Direction = str(input("Please choose direction (N,S,E,W): ")).upper()
while Direction != 'N' and Direction != 'S' and Direction != 'E' and Direction != 'W':
    Direction = str("Please choose direction (N,S,E,W): ")

Time = int(input("Please enter time to nearest minute: "))

if Choice == 1:
    FirstBird.Move(Direction,Time)
    print(f"New Position: {FirstBird.GetPosition()}")
    print(f"New Position: {SecondBird.GetPosition()}")
elif Choice == 2:
    SecondBird.Move(Direction,Time)
    print(f"New Position: {FirstBird.GetPosition()}")
    print(f"New Position: {SecondBird.GetPosition()}")

    
