def BinarySearch(SA, Lower, Upper, SV):
    if Upper >= Lower:
        Mid = int((Lower+(Upper-1)) / 2)
        if SA[0][Mid] ==  SV:
            return Mid
        else:
            if SA[0][Mid] > SV:
                return BinarySearch(SA, Lower, Mid-1, SV)
            else:
                return BinarySearch(SA, Mid+1, Upper, SV)
    return -1

